# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# Copy to .env for local development and add to Vercel/Netlify dashboard
# =============================================================================

# --- SUPABASE CONFIGURATION ---
# Public URL and Anonymous / Publishable Key (safe for client-side)
VITE_SUPABASE_URL=https://rqifrrjdyvloygyhkwbo.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_VjnGcmeiLLQcn1eF6CJYDg_263WuTu3

# Supabase Service Role Key (CRITICAL: Server-side only, NEVER expose to client)
# Used by server-side endpoints for privileged DB operations, signed download URLs & webhooks
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- RAZORPAY CONFIGURATION ---
# Public Key ID (exposed to client for Razorpay Checkout Modal)
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# Razorpay Key Secret (CRITICAL: Server-side only, NEVER expose to client)
# Used for HMAC-SHA256 signature verification & Razorpay Orders API
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Razorpay Webhook Secret (Set in Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# --- SERVER CONFIGURATION ---
PORT=5000
NODE_ENV=development

